# Node.js 24+ is required. Supabase setup: docs/supabase.md.
HOST=0.0.0.0
PORT=3000
# Set to your real HTTPS origin before deployment (used in canonical URLs and sitemap).
SITE_URL=http://localhost:3000
# Used only by the local SQLite fallback; ignored when Supabase is configured.
DATABASE_PATH=./data/bitesbro.sqlite
# Booking and pickup times use this IANA timezone.
CAFE_TIMEZONE=Asia/Kolkata
# Node API writes: requests per IP per 15-minute window.
RATE_LIMIT_MAX=30

# Add actual public settings to ignored .env.local; never a secret/service-role key.
# In GitHub Actions use repository Variables with these exact names.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Fictional local role preview only, when Supabase is entirely unconfigured.
# Supabase mode always disables this setting and the demo role switcher.
APP_DEMO_MODE=false
