# Node.js 24+ is required. No third-party API keys are needed.
HOST=0.0.0.0
PORT=3000
# Set to your real HTTPS origin before deployment (used in canonical URLs and sitemap).
SITE_URL=http://localhost:3000
# Use an absolute path on a persistent volume in production.
DATABASE_PATH=./data/bitesbro.sqlite
# Booking and pickup times use this IANA timezone.
CAFE_TIMEZONE=Asia/Kolkata
# Anonymous public forms: requests per IP per 15-minute window.
RATE_LIMIT_MAX=30
